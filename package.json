{
  "name": "moye-novel",
  "version": "2.5.1",
  "private": true,
  "description": "墨页 · 本地轻量小说写作软件（Electron 桌面壳，原生 fs 持久化）",
  "main": "main.js",
  "author": "峻峻尼",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-plugins-manifest.mjs && electron-builder",
    "test": "node test/plugins.test.mjs && node test/fsstore.test.mjs && node test/format.test.mjs && node test/render-smoke.mjs && node test/plugins-render.test.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^24.0.0"
  },
  "build": {
    "appId": "com.moye.novel",
    "productName": "墨页",
    "copyright": "Copyright © 峻峻尼",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "electronDist": ".electron-dist",
    "extraFiles": [
      { "from": "plugins", "to": "plugins" }
    ],
    "publish": null,
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/appIcon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨页",
      "artifactName": "moye-novel-setup-${version}.${ext}"
    }
  }
}
