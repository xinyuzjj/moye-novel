# 依赖
node_modules/

# 构建中间产物 / 本机二进制（由 build.mjs 自动生成或从 release 下载）
bin/
resources/
.tmp/
temp/

# 构建输出（二进制成品通过 GitHub Releases 发布，不入库）
dist/
dist-electron/
.electron-dist/
.bbcache/
.ecache/

# Release 资产暂存（CI 内生成，本地调试用，不入库）
release/
release_tmp/

# 运行 / 调试日志
*.log
neutralinojs.log

# 本机数据（用户稿件，勿入库）
data/

# 编辑器 / 系统缓存
.DS_Store
Thumbs.db

# 工作区记忆（本地 agent 记忆，非项目资产）
.workbuddy/
